<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="furniture-workspace" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.woodlogix.desktop.ui.furniture.FurnitureWorkspaceController">
    <top>
        <VBox spacing="12.0" styleClass="furniture-workspace-header">
            <padding>
                <Insets bottom="0.0" left="18.0" right="18.0" top="18.0"/>
            </padding>
            <VBox spacing="4.0">
                <Label text="%parts.section" styleClass="section-title"/>
                <Label text="%furniture-workspace.subtitle" styleClass="subtitle"/>
            </VBox>
            <HBox spacing="8.0" styleClass="module-switcher">
                <Button fx:id="itemsButton" text="%furniture-workspace.items"
                        onAction="#showItems" styleClass="module-switch-button"/>
                <Button fx:id="partsButton" text="%furniture-workspace.parts"
                        onAction="#showParts" styleClass="module-switch-button"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="moduleContent" styleClass="furniture-module-content"/>
    </center>
</BorderPane>
