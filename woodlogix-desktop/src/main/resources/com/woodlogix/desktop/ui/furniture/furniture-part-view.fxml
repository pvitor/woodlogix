<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.woodlogix.desktop.ui.furniture.FurniturePartController">
    <VBox spacing="4.0">
        <Label text="%parts.section" styleClass="section-title"/>
        <Label text="%parts.subtitle" styleClass="subtitle"/>
    </VBox>
    <VBox spacing="12.0" styleClass="form-card">
        <Label text="%parts.form-title" styleClass="card-title"/>
        <GridPane hgap="12.0" vgap="10.0">
            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="%parts.environment" styleClass="field-label"/>
                <ComboBox fx:id="environmentComboBox" promptText="%environment.select-customer"
                          maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="%parts.name" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="%parts.name-prompt"/>
            </VBox>
            <HBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="1"
                  GridPane.columnSpan="2">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="%parts.length" styleClass="field-label"/>
                    <TextField fx:id="lengthField" promptText="%parts.dimension-prompt"/>
                </VBox>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="%parts.width" styleClass="field-label"/>
                    <TextField fx:id="widthField" promptText="%parts.dimension-prompt"/>
                </VBox>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="%parts.thickness" styleClass="field-label"/>
                    <TextField fx:id="thicknessField" promptText="%parts.dimension-prompt"/>
                </VBox>
                <VBox spacing="6.0" minWidth="180.0">
                    <Label text="%parts.material" styleClass="field-label"/>
                    <ComboBox fx:id="materialComboBox" maxWidth="Infinity"/>
                </VBox>
            </HBox>
            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2"
                  GridPane.columnSpan="2">
                <Label text="%parts.visible-edges" styleClass="field-label"/>
                <FlowPane fx:id="visibleEdgesPane" hgap="14.0" vgap="8.0"/>
            </VBox>
            <HBox spacing="8.0" alignment="CENTER_RIGHT"
                  GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                <Button fx:id="cancelButton" text="%action.cancel" onAction="#cancelEdit"
                        styleClass="secondary-button" visible="false" managed="false"/>
                <Button fx:id="saveButton" text="%parts.register-button" onAction="#savePart"
                        styleClass="primary-button"/>
            </HBox>
            <columnConstraints>
                <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
            </columnConstraints>
        </GridPane>
    </VBox>
    <Label fx:id="validationLabel" styleClass="validation-error"
           wrapText="true" visible="false" managed="false"/>
    <VBox spacing="10.0" styleClass="table-card" VBox.vgrow="ALWAYS">
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="%parts.list-title" styleClass="card-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="%parts.search-prompt"
                       accessibleText="%parts.search-label" maxWidth="340.0"/>
        </HBox>
        <TableView fx:id="partTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" text="%parts.name" prefWidth="180.0"/>
                <TableColumn fx:id="lengthColumn" text="%parts.length-column" prefWidth="115.0"/>
                <TableColumn fx:id="widthColumn" text="%parts.width-column" prefWidth="115.0"/>
                <TableColumn fx:id="thicknessColumn" text="%parts.thickness-column"
                             prefWidth="120.0"/>
                <TableColumn fx:id="materialColumn" text="%parts.material" prefWidth="165.0"/>
                <TableColumn fx:id="edgesColumn" text="%parts.visible-edges"
                             prefWidth="170.0"/>
                <TableColumn fx:id="actionsColumn" text="%column.actions"
                             prefWidth="155.0" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="statusLabel" text="%status.loading" styleClass="status-label"/>
</VBox>
