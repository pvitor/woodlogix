<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="22.0" styleClass="dashboard-page" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.woodlogix.desktop.ui.dashboard.DashboardController">
    <padding>
        <Insets bottom="26.0" left="28.0" right="28.0" top="26.0"/>
    </padding>
    <VBox spacing="7.0">
        <Label text="%dashboard.eyebrow" styleClass="dashboard-eyebrow"/>
        <Label text="%dashboard.title" styleClass="dashboard-title"/>
        <Label text="%dashboard.subtitle" styleClass="subtitle"/>
    </VBox>
    <GridPane hgap="14.0" vgap="14.0">
        <VBox spacing="8.0" styleClass="dashboard-card" GridPane.columnIndex="0"
              GridPane.rowIndex="0">
            <Label text="%dashboard.customers-title" styleClass="dashboard-card-title"/>
            <Label text="%dashboard.customers-description" styleClass="dashboard-card-copy"
                   wrapText="true"/>
            <Button text="%dashboard.open-customers" onAction="#openCustomers"
                    styleClass="dashboard-link-button"/>
        </VBox>
        <VBox spacing="8.0" styleClass="dashboard-card" GridPane.columnIndex="1"
              GridPane.rowIndex="0">
            <Label text="%dashboard.environments-title" styleClass="dashboard-card-title"/>
            <Label text="%dashboard.environments-description" styleClass="dashboard-card-copy"
                   wrapText="true"/>
            <Button text="%dashboard.open-environments" onAction="#openEnvironments"
                    styleClass="dashboard-link-button"/>
        </VBox>
        <VBox spacing="8.0" styleClass="dashboard-card" GridPane.columnIndex="0"
              GridPane.rowIndex="1">
            <Label text="%dashboard.furniture-title" styleClass="dashboard-card-title"/>
            <Label text="%dashboard.furniture-description" styleClass="dashboard-card-copy"
                   wrapText="true"/>
            <Button text="%dashboard.open-furniture" onAction="#openFurniture"
                    styleClass="dashboard-link-button"/>
        </VBox>
        <VBox spacing="8.0" styleClass="dashboard-card" GridPane.columnIndex="1"
              GridPane.rowIndex="1">
            <Label text="%dashboard.pipeline-title" styleClass="dashboard-card-title"/>
            <Label text="%dashboard.pipeline-description" styleClass="dashboard-card-copy"
                   wrapText="true"/>
            <Button text="%dashboard.open-pipeline" onAction="#openPipeline"
                    styleClass="dashboard-link-button"/>
        </VBox>
        <columnConstraints>
            <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
            <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
        </columnConstraints>
        <rowConstraints>
            <javafx.scene.layout.RowConstraints vgrow="ALWAYS"/>
            <javafx.scene.layout.RowConstraints vgrow="ALWAYS"/>
        </rowConstraints>
    </GridPane>
    <HBox styleClass="dashboard-local-note" spacing="10.0">
        <Label text="●" styleClass="local-note-icon"/>
        <Label text="%dashboard.local-note" styleClass="dashboard-card-copy"
               wrapText="true"/>
    </HBox>
</VBox>
