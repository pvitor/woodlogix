<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="13.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.woodlogix.desktop.ui.kanban.KanbanController">
    <Label text="%pipeline.section" styleClass="section-title"/>
    <HBox spacing="9.0" alignment="CENTER_LEFT">
        <ComboBox fx:id="customerComboBox" promptText="%pipeline.customer" prefWidth="220.0"/>
        <ComboBox fx:id="environmentComboBox" promptText="%pipeline.environment"
                  prefWidth="220.0"/>
        <TextField fx:id="projectNameField" promptText="%pipeline.project" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="projectValueField" promptText="%pipeline.value" prefWidth="140.0"/>
        <Button fx:id="saveButton" text="%pipeline.add" onAction="#saveProject"
                styleClass="primary-button"/>
    </HBox>
    <Label fx:id="validationLabel" styleClass="validation-error"
           wrapText="true" visible="false" managed="false"/>
    <Label text="%pipeline.drag-hint" styleClass="subtitle"/>
    <ScrollPane fitToHeight="true" fitToWidth="false" hbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS" styleClass="kanban-scroll">
        <content>
            <HBox fx:id="kanbanColumns" spacing="12.0" styleClass="kanban-board">
                <padding>
                    <Insets bottom="8.0" left="2.0" right="2.0" top="4.0"/>
                </padding>
            </HBox>
        </content>
    </ScrollPane>
    <Label fx:id="statusLabel" text="%status.loading" styleClass="status-label"/>
</VBox>
