<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" styleClass="pricing-scroll"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.woodlogix.desktop.ui.pricing.PricingController">
    <content>
        <VBox spacing="16.0" styleClass="pricing-page">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="26.0"/>
            </padding>
            <HBox spacing="14.0" alignment="CENTER_LEFT" styleClass="pricing-header">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="%pricing.section" styleClass="section-title"/>
                    <Label text="%pricing.subtitle" styleClass="subtitle" wrapText="true"/>
                </VBox>
                <Label fx:id="statusLabel" text="%status.loading"
                       styleClass="status-label pricing-status" wrapText="true"/>
                <Button text="%pricing.save-draft" onAction="#saveDraftNow"
                        styleClass="secondary-button"/>
            </HBox>

            <HBox spacing="12.0" alignment="CENTER_LEFT"
                  styleClass="form-card pricing-project-panel">
                <VBox spacing="4.0">
                    <Label text="%pricing.project" styleClass="card-title"/>
                    <Label text="%pricing.project-hint" styleClass="panel-hint"
                           wrapText="true"/>
                </VBox>
                <ComboBox fx:id="projectComboBox" promptText="%pricing.project-prompt"
                          maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="%pricing.standalone" onAction="#clearProjectLink"
                        styleClass="secondary-button"/>
            </HBox>

            <VBox fx:id="workpieceForm" spacing="12.0"
                  styleClass="form-card pricing-workpiece-form">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="%pricing.workpiece-form" styleClass="card-title"/>
                        <Label text="%pricing.required-hint" styleClass="panel-hint"
                               wrapText="true"/>
                    </VBox>
                    <Label fx:id="editingIndicator" text="%pricing.editing"
                           styleClass="editing-indicator"
                           visible="false" managed="false"/>
                </HBox>
                <GridPane hgap="12.0" vgap="10.0" styleClass="workpiece-fields">
                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <HBox spacing="3.0">
                            <Label text="%pricing.workpiece-name" styleClass="field-label"/>
                            <Label text="*" styleClass="required-marker"/>
                        </HBox>
                        <TextField fx:id="nameField"/>
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <HBox spacing="3.0">
                            <Label text="%pricing.length" styleClass="field-label"/>
                            <Label text="*" styleClass="required-marker"/>
                        </HBox>
                        <TextField fx:id="lengthField" promptText="%dimension.prompt"/>
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <HBox spacing="3.0">
                            <Label text="%pricing.width" styleClass="field-label"/>
                            <Label text="*" styleClass="required-marker"/>
                        </HBox>
                        <TextField fx:id="widthField" promptText="%dimension.prompt"/>
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <HBox spacing="3.0">
                            <Label text="%pricing.quantity" styleClass="field-label"/>
                            <Label text="*" styleClass="required-marker"/>
                        </HBox>
                        <TextField fx:id="quantityField" promptText="1"/>
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <HBox spacing="3.0">
                            <Label text="%pricing.material" styleClass="field-label"/>
                            <Label text="*" styleClass="required-marker"/>
                        </HBox>
                        <ComboBox fx:id="materialComboBox"
                                  promptText="%pricing.material-prompt" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="%pricing.edgebanding" styleClass="field-label"/>
                        <ComboBox fx:id="edgeBandingComboBox"
                                  promptText="%pricing.edgebanding-optional"
                                  maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="1"
                          GridPane.columnSpan="2">
                        <Label text="%pricing.edges" styleClass="field-label"/>
                        <FlowPane hgap="10.0" vgap="6.0" styleClass="edge-options">
                            <CheckBox fx:id="topEdgeCheckBox" text="%edge.top"/>
                            <CheckBox fx:id="bottomEdgeCheckBox" text="%edge.bottom"/>
                            <CheckBox fx:id="leftEdgeCheckBox" text="%edge.left"/>
                            <CheckBox fx:id="rightEdgeCheckBox" text="%edge.right"/>
                        </FlowPane>
                    </VBox>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="36.0" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="22.0" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="22.0" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="20.0" hgrow="ALWAYS"/>
                    </columnConstraints>
                </GridPane>
                <HBox spacing="8.0" alignment="CENTER_RIGHT">
                    <Button fx:id="cancelEditButton" text="%action.cancel"
                            onAction="#cancelEdit" styleClass="secondary-button"
                            visible="false" managed="false"/>
                    <Button fx:id="addWorkpieceButton" text="%pricing.add-workpiece"
                            onAction="#saveWorkpiece" styleClass="primary-button"/>
                </HBox>
            </VBox>

            <HBox spacing="14.0" VBox.vgrow="ALWAYS" styleClass="pricing-main-row">
                <VBox spacing="9.0" styleClass="table-card pricing-workpiece-list"
                      HBox.hgrow="ALWAYS">
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label text="%pricing.workpiece-list" styleClass="card-title"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label text="%pricing.workpiece-list-hint" styleClass="panel-hint"
                               wrapText="true"/>
                    </HBox>
                    <TableView fx:id="workpieceTable" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="%pricing.empty-workpieces"
                                   styleClass="empty-state" wrapText="true"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="workpieceNameColumn"
                                         text="%pricing.workpiece-name" prefWidth="150.0"/>
                            <TableColumn fx:id="dimensionsColumn" text="%pricing.dimensions"
                                         prefWidth="125.0"/>
                            <TableColumn fx:id="quantityColumn" text="%pricing.quantity"
                                         prefWidth="75.0"/>
                            <TableColumn fx:id="materialColumn" text="%pricing.material"
                                         prefWidth="140.0"/>
                            <TableColumn fx:id="actionsColumn" text="%column.actions"
                                         prefWidth="110.0" sortable="false"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10.0" prefWidth="320.0" minWidth="285.0"
                      styleClass="pricing-summary">
                    <Label text="%pricing.summary" styleClass="card-title"/>
                    <Label text="%pricing.summary-hint" styleClass="panel-hint"
                           wrapText="true"/>
                    <VBox spacing="7.0" styleClass="pricing-totals">
                        <HBox spacing="8.0" styleClass="pricing-summary-row">
                            <Label text="%pricing.sheets"/>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Label fx:id="sheetCountLabel" text="0" styleClass="summary-value"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="pricing-summary-row">
                            <Label text="%pricing.edgebanding-meters"/>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Label fx:id="edgeMetersLabel" text="0 m"
                                   styleClass="summary-value"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="pricing-summary-row">
                            <Label text="%pricing.material-cost"/>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Label fx:id="materialCostLabel" text="—"
                                   styleClass="summary-value"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="pricing-summary-row">
                            <Label text="%pricing.edgebanding-cost"/>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Label fx:id="edgeCostLabel" text="—" styleClass="summary-value"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="pricing-summary-row">
                            <Label text="%pricing.hardware-cost"/>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Label fx:id="hardwareCostLabel" text="—"
                                   styleClass="summary-value"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="pricing-summary-row">
                            <Label text="%pricing.labor-cost"/>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Label fx:id="laborCostLabel" text="—" styleClass="summary-value"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="pricing-summary-row pricing-base-row">
                            <Label text="%pricing.base-cost" styleClass="summary-value"/>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Label fx:id="baseCostLabel" text="—" styleClass="summary-value"/>
                        </HBox>
                        <VBox spacing="5.0" styleClass="suggested-price-panel">
                            <Label text="%pricing.suggested-price" styleClass="suggested-price-title"/>
                            <Label fx:id="suggestedPriceLabel" text="—"
                                   styleClass="summary-price"/>
                        </VBox>
                        <HBox spacing="8.0" styleClass="pricing-summary-row">
                            <Label text="%pricing.net-profit"/>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Label fx:id="profitLabel" text="—" styleClass="summary-value"/>
                        </HBox>
                    </VBox>
                    <Label text="%pricing.summary-note" wrapText="true" styleClass="summary-note"/>
                </VBox>
            </HBox>

            <HBox spacing="14.0" styleClass="pricing-details-row">
                <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                      styleClass="form-card pricing-parameters-card">
                    <VBox spacing="4.0">
                        <Label text="%pricing.parameters-title" styleClass="card-title"/>
                        <Label text="%pricing.parameters-hint" styleClass="panel-hint"
                               wrapText="true"/>
                    </VBox>
                    <GridPane hgap="12.0" vgap="9.0">
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="%pricing.waste" styleClass="field-label"/>
                            <TextField fx:id="wasteField" promptText="15"/>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="%pricing.hours" styleClass="field-label"/>
                            <TextField fx:id="hoursField" promptText="0"/>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="%pricing.labor-rate" styleClass="field-label"/>
                            <TextField fx:id="laborRateField" promptText="0"/>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="%pricing.machine-rate" styleClass="field-label"/>
                            <TextField fx:id="machineRateField" promptText="0"/>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2"
                              GridPane.columnSpan="2">
                            <Label text="%pricing.margin" styleClass="field-label"/>
                            <TextField fx:id="marginField" promptText="30"/>
                        </VBox>
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                      styleClass="form-card pricing-hardware-card">
                    <VBox spacing="4.0">
                        <Label text="%pricing.hardware-title" styleClass="card-title"/>
                        <Label text="%pricing.hardware-hint" styleClass="panel-hint"
                               wrapText="true"/>
                    </VBox>
                    <ComboBox fx:id="hardwareComboBox" promptText="%pricing.hardware-prompt"
                              maxWidth="Infinity"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <TextField fx:id="hardwareQuantityField"
                                   promptText="%pricing.quantity" HBox.hgrow="ALWAYS"/>
                        <Button text="%pricing.add-hardware" onAction="#addHardware"
                                styleClass="secondary-button"/>
                    </HBox>
                    <VBox fx:id="hardwareSummary" spacing="5.0"
                          styleClass="hardware-summary-list"/>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
